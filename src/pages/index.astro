<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Ramssen Sony is a software engineer in Jacksonville, Florida, building web and mobile applications with Flutter, Java, Node.js, Firebase, and API integrations."
    />
    <meta name="theme-color" content="#f7f8f3" />

    <title>Ramssen Sony | Software Engineer</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Ramssen Sony | Software Engineer" />
    <meta property="og:description" content="Web and mobile development, API integrations, and CRM automation. Explore my work and experience." />
    <meta name="twitter:card" content="summary" />

    <script is:inline>
      try {
        const saved = localStorage.getItem("rs-theme");
        const theme =
          saved === "dark" || saved === "light" ? saved : "light";

        document.documentElement.dataset.theme = theme;
      } catch (_) {}
    </script>

    <style is:global>
      @import url("https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap");

      :root {
        color-scheme: light;
        --bg: #f7f8f3;
        --surface: #ffffff;
        --soft: #ecefe6;
        --ink: #172c28;
        --muted: #596b63;
        --line: #d7dfd5;
        --accent: #d4f28a;
        --accent-ink: #172c28;
        --deep: #173b32;
        --shadow: 0 20px 60px #173b3210;
      }

      :root[data-theme="dark"] {
        color-scheme: dark;
        --bg: #101b18;
        --surface: #182722;
        --soft: #20352c;
        --ink: #edf4e8;
        --muted: #a8b9ae;
        --line: #34473b;
        --accent: #d4f28a;
        --accent-ink: #172c28;
        --deep: #10241c;
        --shadow: 0 20px 60px #0002;
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
        scroll-padding-top: 100px;
      }

      body {
        margin: 0;
        background: var(--bg);
        color: var(--ink);
        font-family: "DM Sans", Arial, sans-serif;
        font-size: 16px;
        line-height: 1.65;
      }

      button,
      a {
        -webkit-tap-highlight-color: transparent;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      button {
        color: inherit;
        font: inherit;
        cursor: pointer;
      }

      button,
      a,
      summary {
        touch-action: manipulation;
      }

      a:focus-visible,
      button:focus-visible,
      summary:focus-visible {
        outline: 3px solid #6b9928;
        outline-offset: 5px;
      }

      h1,
      h2,
      h3,
      p {
        margin: 0;
      }

      h1,
      h2,
      h3,
      .brand {
        font-family: "Manrope", Arial, sans-serif;
      }

      h1,
      h2,
      h3 {
        line-height: 1.12;
        letter-spacing: -0.045em;
      }

      svg {
        width: 20px;
        height: 20px;
        flex-shrink: 0;
      }

      ::selection {
        background: var(--accent);
        color: var(--accent-ink);
      }

      .wrap {
        width: min(1120px, calc(100% - 64px));
        margin-inline: auto;
      }

      .skip {
        position: fixed;
        top: -90px;
        left: 20px;
        z-index: 100;
        padding: 12px 20px;
        background: var(--accent);
        color: var(--accent-ink);
      }

      .skip:focus {
        top: 12px;
      }

      /* Navigation */

      .header {
        position: sticky;
        top: 0;
        z-index: 30;
        background: var(--bg);
        border-bottom: 1px solid var(--line);
      }

      .nav {
        display: flex;
        align-items: center;
        gap: 28px;
        min-height: 84px;
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 11px;
        font-weight: 800;
        font-size: 16px;
        letter-spacing: -0.04em;
        white-space: nowrap;
      }

      .brand-mark {
        display: grid;
        place-items: center;
        width: 35px;
        height: 35px;
        background: var(--ink);
        color: var(--bg);
        border-radius: 50%;
        font-size: 13px;
        letter-spacing: -0.04em;
      }

      .nav-links {
        display: flex;
        gap: 25px;
        margin-left: auto;
        font-size: 13px;
        font-weight: 600;
      }

      .nav-links a {
        border-bottom: 1px solid transparent;
      }

      .nav-links a:hover {
        border-color: var(--ink);
      }

      .nav-actions {
        display: flex;
        align-items: center;
        gap: 10px;
      }

      .theme {
        display: grid;
        place-items: center;
        width: 38px;
        height: 38px;
        border: 1px solid var(--line);
        background: transparent;
        border-radius: 50%;
      }

      .resume-small {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 9px 14px;
        font-size: 13px;
        font-weight: 700;
        border: 1px solid var(--line);
        border-radius: 25px;
      }

      .resume-small svg {
        width: 15px;
        height: 15px;
      }

      .mobile-menu {
        display: none;
        position: relative;
      }

      .mobile-menu > summary {
        list-style: none;
        cursor: pointer;
        padding: 8px;
        border: 1px solid var(--line);
        border-radius: 8px;
        font-size: 13px;
      }

      .mobile-menu > summary::-webkit-details-marker {
        display: none;
      }

      .mobile-menu nav {
        position: absolute;
        right: 0;
        top: 45px;
        min-width: 180px;
        padding: 10px;
        background: var(--surface);
        box-shadow: var(--shadow);
        border: 1px solid var(--line);
        border-radius: 12px;
      }

      .mobile-menu nav a {
        display: block;
        padding: 10px;
      }

      /* Hero */

      .hero {
        padding: 80px 0 68px;
      }

      .hero-grid {
        display: grid;
        grid-template-columns: 1.4fr 1fr;
        gap: 60px;
        align-items: center;
      }

      .eyebrow {
        display: flex;
        align-items: center;
        gap: 8px;
        text-transform: uppercase;
        letter-spacing: 0.15em;
        font-size: 13px;
        font-weight: 700;
      }

      .availability {
        display: inline-flex;
        padding: 7px 11px;
        border: 1px solid var(--line);
        border-radius: 30px;
        letter-spacing: 0.08em;
        margin-bottom: 26px;
      }

      .dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #6a982b;
        box-shadow: 0 0 0 3px #8eb03b17;
      }

      .hero h1 {
        max-width: 700px;
        font-size: clamp(42px, 5.2vw, 65px);
        font-weight: 800;
        line-height: 1.08;
      }

      .hero h1 span {
        color: var(--muted);
      }

      .intro {
        max-width: 490px;
        margin-top: 23px;
        color: var(--muted);
        font-size: 16px;
      }

      .hero-buttons {
        display: flex;
        flex-wrap: wrap;
        gap: 13px;
        margin-top: 28px;
      }

      .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        min-height: 46px;
        padding: 12px 19px;
        font-size: 13px;
        font-weight: 700;
        border: 1px solid var(--line);
        border-radius: 7px;
        transition:
          transform 0.2s,
          background 0.2s;
      }

      .button:hover {
        transform: translateY(-2px);
        background: var(--soft);
      }

      .button.primary {
        background: var(--accent);
        border-color: var(--accent);
        color: var(--accent-ink);
      }

      .button.primary:hover {
        background: #c6e477;
      }

      .button svg {
        width: 16px;
        height: 16px;
      }

      .hero-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
        margin-top: 27px;
        color: var(--muted);
        font-size: 13px;
      }

      .hero-meta span {
        display: flex;
        align-items: center;
        gap: 6px;
      }

      .hero-meta svg {
        width: 13px;
        height: 13px;
      }

      /* Profile */

      .profile {
        position: relative;
        padding: 24px;
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 18px;
        box-shadow: var(--shadow);
      }

      .profile-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        color: var(--muted);
        font-size: 13px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }

      .profile-top span:last-child {
        padding: 4px 9px;
        background: var(--soft);
        border-radius: 20px;
        font-size: 13px;
      }

      .profile-photo {
        display: block;
        width: 190px;
        height: 190px;
        margin: 22px auto;
        border-radius: 50%;
        object-fit: cover;
        background: var(--soft);
        border: 1px solid var(--line);
      }

      .profile h2 {
        font-size: 23px;
        letter-spacing: -0.04em;
      }

      .profile .degree {
        margin-top: 6px;
        color: var(--muted);
        font-size: 13px;
      }

      .profile-lines {
        margin-top: 18px;
        border-top: 1px solid var(--line);
      }

      .profile-line {
        display: flex;
        justify-content: space-between;
        gap: 10px;
        padding: 10px 0;
        border-bottom: 1px solid var(--line);
        font-size: 13px;
      }

      .profile-line span {
        color: var(--muted);
      }

      .profile-line strong {
        font-weight: 600;
      }

      .profile-links {
        display: flex;
        gap: 18px;
        margin-top: 18px;
        font-size: 13px;
        font-weight: 700;
      }

      .profile-links a:hover {
        text-decoration: underline;
      }

      /* Capabilities */

      .capabilities {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 24px;
        padding: 25px 0;
        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
      }

      .capability {
        display: flex;
        align-items: flex-start;
        gap: 12px;
      }

      .cap-icon {
        display: grid;
        place-items: center;
        width: 35px;
        height: 35px;
        flex-shrink: 0;
        background: var(--soft);
        border-radius: 8px;
      }

      .capability h3 {
        margin: 2px 0 6px;
        font-size: 13px;
        letter-spacing: -0.02em;
      }

      .capability p {
        color: var(--muted);
        font-size: 13px;
        line-height: 1.6;
      }

      /* Sections */

      .section {
        padding: 76px 0;
      }

      .section-heading {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 24px;
        margin-bottom: 30px;
      }

      .section-heading h2 {
        margin-top: 10px;
        font-size: 35px;
      }

      .section-heading > p {
        max-width: 290px;
        color: var(--muted);
        font-size: 13px;
      }

      .section-number {
        color: var(--muted);
        font-size: 13px;
        letter-spacing: 0.12em;
      }

      /* Projects */

      .projects {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 24px;
      }

      .project {
        min-width: 0;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 12px;
      }

      .project-art {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 190px;
        padding: 24px;
        overflow: hidden;
        background: var(--soft);
      }

      .project-featured {
        grid-column: 1 / -1;
        display: grid;
        grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
        align-items: stretch;
        border-radius: 16px;
      }

      .project-featured .project-body {
        min-width: 0;
        justify-content: center;
        padding: clamp(24px, 3vw, 40px);
      }

      .project-featured h3 {
        font-size: clamp(24px, 2.6vw, 32px);
      }

      .project-featured p,
      .project-featured details p,
      .project-featured details ul {
        font-size: 14px;
        line-height: 1.75;
      }

      .project-featured .project-status {
        font-size: 11px;
        line-height: 1.7;
        letter-spacing: 0.08em;
      }

      .project-featured .fitlog-preview {
        height: auto;
        min-width: 0;
        padding: clamp(14px, 2vw, 24px);
        background: #191a18;
        border-right: 1px solid var(--line);
      }

      .fitlog-preview img {
        display: block;
        width: 100%;
        max-width: 480px;
        height: auto;
        object-fit: contain;
      }

      .fitlog-preview:focus-visible {
        outline-offset: -5px;
      }

      @media (max-width: 720px) {
        .project-featured {
          grid-template-columns: minmax(0, 1fr);
        }

        .project-featured .fitlog-preview {
          border-right: 0;
          border-bottom: 1px solid var(--line);
          padding: 16px;
        }

        .project-featured .project-body {
          padding: 24px;
        }
      }

      .screenshot-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-top: 16px;
        font-size: 13px;
        font-weight: 700;
        text-decoration: underline;
        text-underline-offset: 4px;
      }

      .art-two {
        background: #e2e9ee;
      }

      .art-three {
        background: #eee8dc;
      }

      .db-visual {
        display: grid;
        gap: 9px;
        width: 180px;
        transform: rotate(-5deg);
      }

      .db-row {
        display: grid;
        grid-template-columns: 28px 1fr 22px;
        align-items: center;
        gap: 10px;
        padding: 12px;
        background: #ffffff;
        border: 1px solid #c7d7dd;
        border-radius: 6px;
        box-shadow: 6px 6px 0 #173b3207;
      }

      .db-row i {
        height: 5px;
        background: #bed0d7;
        border-radius: 3px;
      }

      .db-row i:first-child {
        height: 15px;
        background: #6d8b9a;
      }

      .chart-visual {
        display: flex;
        align-items: flex-end;
        gap: 9px;
        width: 180px;
        height: 100px;
        padding-left: 12px;
        border-left: 1px solid #b8b09d;
        border-bottom: 1px solid #b8b09d;
      }

      .chart-visual span {
        flex: 1;
        height: var(--bar);
        background: #708b66;
        border-radius: 4px 4px 0 0;
      }

      .chart-visual span:nth-child(2n) {
        background: #aec08c;
      }

      .project-body {
        display: flex;
        flex-direction: column;
        flex: 1;
        padding: 21px;
      }

      .project-status {
        margin-bottom: 11px;
        color: var(--muted);
        font-size: 13px;
        text-transform: uppercase;
        letter-spacing: 0.1em;
      }

      .project h3 {
        font-size: 19px;
        letter-spacing: -0.035em;
        line-height: 1.2;
      }

      .project p {
        margin-top: 12px;
        color: var(--muted);
        font-size: 13px;
      }

      .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 5px;
        margin-top: 16px;
      }

      .tag {
        padding: 3px 7px;
        border: 1px solid var(--line);
        border-radius: 4px;
        color: var(--muted);
        font-size: 13px;
      }

      .project details {
        margin-top: 20px;
        padding-top: 13px;
        border-top: 1px solid var(--line);
      }

      .project summary {
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
      }

      .project details p {
        font-size: 13px;
      }

      .project details ul {
        margin-bottom: 0;
        padding-left: 16px;
        color: var(--muted);
        font-size: 13px;
      }

      .art-note {
        margin-top: 12px;
        color: var(--muted);
        font-size: 13px;
      }

      /* Experience */

      .experience-section {
        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
      }

      .experience-grid {
        display: grid;
        grid-template-columns: 0.75fr 1.5fr;
        gap: 75px;
      }

      .experience-intro h2 {
        margin-top: 10px;
        font-size: 35px;
      }

      .experience-intro p {
        margin-top: 20px;
        color: var(--muted);
        font-size: 13px;
      }

      .timeline {
        display: grid;
        gap: 27px;
      }

      .job {
        position: relative;
        padding-left: 23px;
        border-left: 2px solid var(--line);
      }

      .job::before {
        content: "";
        position: absolute;
        left: -5px;
        top: 5px;
        width: 8px;
        height: 8px;
        background: var(--accent);
        border: 2px solid var(--ink);
        border-radius: 50%;
      }

      .job-top {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 12px;
      }

      .job h3 {
        font-size: 16px;
        letter-spacing: -0.025em;
      }

      .job time {
        color: var(--muted);
        font-size: 13px;
        white-space: nowrap;
      }

      .job-role {
        margin-top: 6px;
        font-size: 13px;
        font-weight: 600;
      }

      .job p:last-child {
        margin-top: 9px;
        color: var(--muted);
        font-size: 13px;
      }

      /* About and skills */

      .about-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 80px;
      }

      .about h2 {
        margin-top: 10px;
        font-size: 35px;
      }

      .about p {
        margin-top: 19px;
        color: var(--muted);
        font-size: 14px;
      }

      .skills {
        display: grid;
        gap: 18px;
      }

      .skill-row {
        padding-bottom: 17px;
        border-bottom: 1px solid var(--line);
      }

      .skill-row h3 {
        margin-bottom: 9px;
        font-size: 13px;
        letter-spacing: 0.02em;
      }

      .skill-row p {
        color: var(--muted);
        font-size: 13px;
        line-height: 1.8;
      }

      .education {
        margin-top: 20px;
        padding-left: 12px;
        border-left: 3px solid var(--accent);
        font-size: 13px;
      }

      .education strong {
        display: block;
      }

      .education span {
        color: var(--muted);
      }

      /* Contact */

      .contact {
        display: grid;
        grid-template-columns: 1.2fr 1fr;
        align-items: center;
        gap: 40px;
        padding: 45px;
        background: var(--deep);
        color: #f1f7ea;
        border-radius: 15px;
      }

      .contact .eyebrow {
        color: #c4d3bf;
      }

      .contact h2 {
        margin-top: 12px;
        font-size: 35px;
      }

      .contact p {
        max-width: 410px;
        margin-top: 16px;
        color: #c4d3bf;
        font-size: 13px;
      }

      .contact-actions {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 15px;
      }

      .contact-email {
        padding-bottom: 6px;
        border-bottom: 1px solid #869f8b;
        font-size: clamp(14px, 2vw, 20px);
        font-weight: 600;
        word-break: break-word;
      }

      .contact-controls {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
      }

      .contact .button {
        border-color: #ffffff30;
      }

      .contact .button:not(.primary) {
        color: #f1f7ea;
      }

      .contact .button:not(.primary):hover {
        background: #ffffff10;
      }

      .copy-status {
        min-height: 16px;
        color: #c4d3bf;
        font-size: 13px;
      }

      .footer {
        display: flex;
        justify-content: space-between;
        gap: 15px;
        padding: 28px 0 36px;
        color: var(--muted);
        font-size: 13px;
      }

      .footer-links {
        display: flex;
        gap: 18px;
      }

      /* Responsive layouts */

      @media (min-width: 1500px) {
        .hero {
          padding-block: 100px;
        }

        .hero h1 {
          font-size: 68px;
        }
      }

      @media (max-width: 1000px) {
        .nav-links {
          gap: 16px;
        }

        .nav {
          gap: 16px;
        }

        .hero-grid {
          gap: 30px;
        }

        .hero h1 {
          font-size: 49px;
        }

        .profile {
          padding: 20px;
        }

        .projects {
          gap: 12px;
        }

        .project-body {
          padding: 17px;
        }

        .experience-grid,
        .about-grid {
          gap: 40px;
        }

        .contact {
          padding: 32px;
        }

        .brand-name {
          display: none;
        }
      }

      @media (max-width: 720px) {
        .wrap {
          width: calc(100% - 36px);
        }

        .nav {
          min-height: 69px;
          gap: 12px;
        }

        .brand-name {
          display: block;
        }

        .nav-links {
          display: none;
        }

        .nav-actions {
          margin-left: auto;
        }

        .resume-small {
          display: none;
        }

        .mobile-menu {
          display: block;
        }

        .hero {
          padding: 40px 0;
        }

        .hero-grid {
          grid-template-columns: 1fr;
          gap: 32px;
        }

        .hero h1 {
          font-size: clamp(39px, 9.8vw, 62px);
        }

        .intro {
          font-size: 15px;
        }

        .availability {
          margin-bottom: 23px;
          font-size: 13px;
        }

        .profile {
          max-width: none;
        }

        .profile-photo {
          width: 170px;
          height: 170px;
        }

        .hero-meta {
          gap: 14px;
          font-size: 13px;
        }

